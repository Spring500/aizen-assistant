{
  "name": "aizen-assistant",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:config": "bun run scripts/repo/validate-config.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "verify": "bun run check:config && bun run format:check && bun run lint && bun run typecheck && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  }
}
