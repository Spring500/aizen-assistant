{
  "name": "aizen-assistant",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:config": "bun run scripts/repo/validate-config.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:gate": "bun build --compile --target=bun-windows-x64 --outfile dist/aizen-architecture-gate.exe apps/architecture-gate/src/main.ts",
    "test:gate": "bun test tests/architecture-gate",
    "verify:gate": "bun run test:gate && bun run build:gate && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/distribution/verify-architecture-gate.ps1",
    "start-mock": "bun run apps/architecture-gate/src/start-mock.ts",
    "verify": "bun run check:config && bun run format:check && bun run lint && bun run typecheck && bun test && bun run verify:gate",
    "hooks:install": "git config core.hooksPath .githooks",
    "hooks:test": "bun run scripts/repo/test-pre-push.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@opentui/core": "0.4.5",
    "@silvia-odwyer/photon-node": "0.3.4"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "0.80.10",
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-tui": "0.80.10"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  }
}
